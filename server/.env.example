# Server Port and Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=laundry_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laundry_db

# JWT Secret for Student and Staff Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# MQTT Configuration (Mosquitto broker)
MQTT_BROKER_URL=mqtt://localhost:1883
# Set to 'true' to start an embedded Aedes MQTT broker inside the server process if Mosquitto is not running
USE_EMBEDDED_BROKER=false

# Razorpay Test Mode Credentials
# Leave as test defaults or add your keys from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_sampleKeyId1234
RAZORPAY_KEY_SECRET=sampleSecretKey5678
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret9999

# Anthropic Claude Configuration for RAG AI Assistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# Embedding Configuration for RAG Vector Search
# Dimension: 1024 (matches Voyage / Cohere / standard vector search configured in migrations)
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=local
